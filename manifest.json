{
  "manifest_version": 3,
  "name": "Stream Bridge · Prototyp",
  "version": "0.3.0",
  "description": "YouTube-Livestreams über Twitch-Profillinks finden, auf Twitch ansehen und den Chat behalten. Nutzt den normalen YouTube-Player.",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*",
    "https://*.ttvnw.net/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["config.js", "discovery.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": { "default_title": "Stream Bridge", "default_popup": "popup.html" }
}
